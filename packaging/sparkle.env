# Sparkle 2, the updater of the direct-download build (DMG, Homebrew). Sourced by the
# packaging scripts. To upgrade: change the version, run packaging/fetch-sparkle.sh (it
# stops and prints the new archive's checksum), check the release notes, paste it here.
SPARKLE_VERSION=2.10.1
SPARKLE_URL="https://github.com/sparkle-project/Sparkle/releases/download/${SPARKLE_VERSION}/Sparkle-${SPARKLE_VERSION}.tar.xz"
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27

# Where the app looks for updates (Info.plist SUFeedURL): appcast.xml on a release of its
# own, tag SPARKLE_APPCAST_TAG, which release.sh tells you to create with the first release
# and to update (gh release upload --clobber) with every later one. The URL is fixed and
# exists from the first release on, whether or not the newest version release is a
# pre-release (GitHub's releases/latest/download/... skips pre-releases and 404s while there
# are only betas). Needs the repo (or a public releases repo) to be public.
SPARKLE_APPCAST_TAG=appcast
SPARKLE_FEED_URL="https://github.com/william-ricchiuti/vault-wallpaper/releases/download/${SPARKLE_APPCAST_TAG}/appcast.xml"

# The EdDSA public key (Info.plist SUPublicEDKey) printed by packaging/sparkle-keys.sh.
# Public, safe to commit. While it is the placeholder, the app's updater stays off.
SPARKLE_PUBLIC_ED_KEY=ALz2Gcr0PQdIjhcXQVC2ayFR/0giwKX3Rem2C7X0gOI=
