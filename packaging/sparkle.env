# Sparkle 2, the updater of the direct-download build (DMG, Homebrew). Sourced by the
# packaging scripts. To upgrade: change the version, run packaging/fetch-sparkle.sh (it
# stops and prints the new archive's checksum), check the release notes, paste it here.
SPARKLE_VERSION=2.10.1
SPARKLE_URL="https://github.com/sparkle-project/Sparkle/releases/download/${SPARKLE_VERSION}/Sparkle-${SPARKLE_VERSION}.tar.xz"
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27

# Where the app looks for updates (Info.plist SUFeedURL). GitHub serves the newest
# release's asset at this fixed URL, so every release uploads its own appcast.xml.
# Needs the repo (or a public releases repo) to be public.
SPARKLE_FEED_URL="https://github.com/william-ricchiuti/vault-wallpaper/releases/latest/download/appcast.xml"

# The EdDSA public key (Info.plist SUPublicEDKey) printed by packaging/sparkle-keys.sh.
# Public, safe to commit. While it is the placeholder, the app's updater stays off.
SPARKLE_PUBLIC_ED_KEY=REPLACE_WITH_SPARKLE_PUBLIC_ED_KEY
